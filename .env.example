DATABASE_URL=
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
APP_URL=http://localhost:3000
OWNER_USER_ID=
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# IA opcional via API compatível com OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini

# Microserviço Python opcional para análise local da IA
PY_AI_ENABLED=false
PY_AI_BASE_URL=http://127.0.0.1:8001
PY_AI_TIMEOUT_MS=2500
PY_AI_SHADOW_MODE=false
PY_AI_ENABLE_PROPHET=false

# Exemplo para Groq:
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile

# Webhook opcional para alertas internos
OWNER_NOTIFICATION_WEBHOOK_URL=

# Suporte NEXO opcional
# OWNER_NOTIFICATION_WEBHOOK_URL pode receber uma ou mais URLs separadas por vírgula.
# Para CallMeBot/WhatsApp, coloque a URL completa com phone/apikey/text se desejar.
GITHUB_TOKEN=
GITHUB_SUPPORT_REPO=macksongaspar/nexo.finance
GITHUB_SUPPORT_LABEL_BUG=bug
GITHUB_SUPPORT_LABEL_SUGGESTION=sugestao

# Stripe opcional
STRIPE_SECRET_KEY=
STRIPE_PREMIUM_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_ELITE_PRICE_ID=
STRIPE_PREMIUM_PRODUCT_ID=
STRIPE_PRO_PRODUCT_ID=
STRIPE_ELITE_PRODUCT_ID=
# Alternativa recomendada para desenvolvimento local, caso use Stripe Payment Links
STRIPE_PREMIUM_PAYMENT_LINK=
STRIPE_PRO_PAYMENT_LINK=
STRIPE_ELITE_PAYMENT_LINK=
# Alternativa rápida no frontend, caso queira redirecionar sem chamar o servidor
VITE_STRIPE_PREMIUM_PAYMENT_LINK=
VITE_STRIPE_PRO_PAYMENT_LINK=
VITE_STRIPE_ELITE_PAYMENT_LINK=
